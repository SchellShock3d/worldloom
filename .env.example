# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to use the built-in embedded Postgres (PGlite),
# stored in ./.data/pglite. Set it to use Supabase, Neon, or your own Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/worldloom
DATABASE_URL=
# Where the embedded database lives when DATABASE_URL is empty.
# PGLITE_DIR=./.data/pglite

# Run pending migrations automatically on first database access (default true).
AUTO_MIGRATE=true

# --- AI ---------------------------------------------------------------------
# "anthropic" uses Claude via ANTHROPIC_API_KEY. "offline" uses the built-in
# rules engine (no network). If unset, Anthropic is used when a key is present.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Model used for generation and analysis.
AI_MODEL=claude-sonnet-5-5
# Faster model used for quick generators ("I need something now").
AI_FAST_MODEL=claude-haiku-4-5-20251001

# --- Music (optional) -------------------------------------------------------------
# Google Lyria composes scene music and ambience. Get a key at
# https://aistudio.google.com/apikey (Lyria needs billing on the key's project).
GEMINI_API_KEY=

# --- Files ------------------------------------------------------------------
# Where uploaded maps, images and audio are stored (local disk driver).
UPLOAD_DIR=./.data/uploads

# --- Rarely needed -----------------------------------------------------------
# Sign-in cookies follow the connection: Secure over HTTPS, plain over
# http://localhost or a LAN address. Set this to "true" only to force plain
# cookies behind a proxy that hides the protocol.
# INSECURE_COOKIES=true
